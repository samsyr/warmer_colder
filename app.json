{
  "expo": {
    "name": "Warmer / Colder",
    "slug": "warmer-colder-poc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0E0E12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.samponen.warmercolder",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Warmer / Colder uses your location to tell you whether you are getting closer to or farther from your chosen target.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Warmer / Colder uses your location to tell you whether you are getting closer to or farther from your chosen target."
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ac839bc7-d0fd-4b5b-919b-30c49cbee100"
      }
    },
    "owner": "samponen"
  }
}
